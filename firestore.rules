rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===========================
    // HELPER FUNCTIONS
    // ===========================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    function isEngineer() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/engineers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/engineers/$(request.auth.uid)).data.status == 'verified';
    }
    
    function isValidEmail(email) {
      return email.matches('.*@.*\\..*');
    }
    
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }
    
    // ===========================
    // USERS COLLECTION - FIXED FOR SIGNUP
    // ===========================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId &&
                       request.resource.data.keys().hasAll(['email']) &&
                       request.resource.data.email is string;
      
      allow update: if (isOwner(userId) &&
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) ||
                       isAdmin();
      
      allow delete: if isAdmin();
    }
    
    // ===========================
    // ENGINEERS COLLECTION - FIXED FOR APPLICATIONS
    // ===========================
    match /engineers/{engineerId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
                       request.auth.uid == engineerId &&
                       request.resource.data.keys().hasAll(['email']) &&
                       request.resource.data.email is string;
      
      allow update: if (isOwner(engineerId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role'])) ||
                       isAdmin();
      
      allow delete: if isAdmin();
    }
    
    // ===========================
    // PROFILES COLLECTION - FIXED
    // ===========================
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      allow update: if isOwner(userId);
      
      allow delete: if isAdmin();
    }
    
    // ===========================
    // REPORTS COLLECTION
    // ===========================
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (
                     isOwner(resource.data.userId) ||
                     (resource.data.flaggedForInspection == true && isEngineer()) ||
                     isAdmin()
                  );
      
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
                       (isOwner(resource.data.userId) && 
                        request.resource.data.userId == resource.data.userId) ||
                       (resource.data.flaggedForInspection == true && isEngineer()) ||
                       isAdmin()
                    );
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      match /detections/{detectionId} {
        allow read: if isAuthenticated() && (
                       isOwner(get(/databases/$(database)/documents/reports/$(reportId)).data.userId) ||
                       (get(/databases/$(database)/documents/reports/$(reportId)).data.flaggedForInspection == true && isEngineer()) ||
                       isAdmin()
                    );
        
        allow write: if isAuthenticated() &&
                        isOwner(get(/databases/$(database)/documents/reports/$(reportId)).data.userId);
      }
    }
    
    // ===========================
    // FLAGGED REPORTS COLLECTION - SIMPLIFIED FOR DEBUGGING
    // ===========================
    match /flagged_reports/{reportId} {
      // ✅ SIMPLIFIED: Allow any authenticated user to read/write flagged reports
      // This is temporary for debugging - we'll make it more secure later
      allow read, write: if request.auth != null;
    }
    
    // ===========================
    // CONTACTS COLLECTION
    // ===========================
    match /contacts/{contactId} {
      allow create: if request.resource.data.email is string &&
                       request.resource.data.message is string;
      
      allow read, update, delete: if isAdmin();
    }
    
    // ===========================
    // SETTINGS COLLECTION
    // ===========================
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }
    
    // ===========================
    // POSTS COLLECTION
    // ===========================
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid;
      
      allow update, delete: if isOwner(resource.data.authorId) || isAdmin();
    }
    
    // ===========================
    // CONNECTION TEST COLLECTIONS - FIXED
    // ===========================
    match /connection_test/{testId} {
      // ✅ Allow authenticated users to test connection
      allow read, write: if isAuthenticated();
    }
    
    // ===========================
    // TEST COLLECTION - FIXED FOR CONNECTIVITY TESTS
    // ===========================
    match /test/{document=**} {
      // ✅ CHANGED: Allow authenticated users (not just admins)
      // This allows your app to test Firestore connectivity during flagging
      allow read, write: if isAuthenticated();
      
      // ⚠️ SECURITY NOTE: Consider restricting this in production
      // For production, use connection_test collection instead
    }
    
    // ===========================
    // DENY ALL OTHER ACCESS
    // ===========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}